# Firebase konsolu > Proje ayarları > Genel > "Uygulamalarınız" (Web) bölümünden kopyala.
# Bu değerler istemci tarafında görünür; gizli anahtar DEĞİLDİR.
# Güvenlik Firestore kurallarıyla sağlanır (firestore.rules).
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=proje-kimligi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=proje-kimligi
VITE_FIREBASE_STORAGE_BUCKET=proje-kimligi.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# İsteğe bağlı: yerel geliştirmede Firebase emülatörlerine bağlan
# VITE_USE_EMULATORS=true
