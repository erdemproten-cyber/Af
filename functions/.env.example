# Cloud Functions ortam değişkenleri (functions/.env olarak kopyalayın).
# Bu dosya .gitignore'dadır; gizli anahtarları ASLA koda gömmeyin.

# Uygulamanın tek kullanıcısının Firebase Auth UID'si.
# Firebase konsolu > Authentication > Kullanıcılar sütunundan kopyalayın.
SAHIP_UID=

# Webhook'u doğrulamak için kullanılan paylaşılan gizli anahtar.
# Shopier'e vereceğiniz URL'ye ?anahtar=... olarak eklenir
# ve ayrıca x-webhook-anahtari başlığından okunur.
SHOPIER_WEBHOOK_ANAHTARI=

# Shopier geliştirici portalındaki API anahtar/şifre çifti (imza doğrulaması için).
# Boş bırakılırsa imza doğrulaması atlanır, yalnızca paylaşılan anahtar kontrol edilir.
SHOPIER_API_KEY=
SHOPIER_API_SECRET=

# Ürün kodu ön eki: "AF-012" → 12
URUN_KODU_ON_EKI=AF
